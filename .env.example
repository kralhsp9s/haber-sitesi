# Server
PORT=10000
NODE_ENV=production
SESSION_SECRET=change-this-to-a-long-random-value
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password

# RapidAPI
# API anahtarını burada tutmak yerine panelden de girebilirsin.
INSTAGRAM_API_HOST=instagram-scraper2.p.rapidapi.com
INSTAGRAM_API_PATH=/user_medias

# Web Push / VAPID
# npm run generate-vapid ile üret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
