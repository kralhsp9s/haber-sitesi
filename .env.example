# Sunucu
PORT=10000
SESSION_SECRET=change-this-to-a-long-random-string
NODE_ENV=production

# Giriş
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# RapidAPI
INSTAGRAM_API_HOST=instagram-scraper2.p.rapidapi.com
INSTAGRAM_API_PATH=/user_medias
# Sağlayıcınızın kullanıcı adı -> numeric ID endpoint'i
INSTAGRAM_USER_LOOKUP_PATH=/search_user
# Hikâyeler için endpoint; desteklemiyorsa boş bırakın
INSTAGRAM_STORY_PATH=

# Web Push (npm run generate-vapid ile üretilebilir)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Sourcebin
SOURCEBIN_API_URL=https://sourceb.in/api
